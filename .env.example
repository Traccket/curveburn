# ============================================================
# Variables de entorno de CURVE landing
# ------------------------------------------------------------
# Copia este archivo a .env.local para desarrollo, y configura
# los mismos valores en Vercel → Settings → Environment Variables
# para producción. Todas usan el prefijo VITE_ (expuestas al cliente).
#
# Mientras no estén configuradas, la landing detecta los placeholders
# y deshabilita/oculta los enlaces y el tracking correspondientes.
# ============================================================

# --- Tracking (se cargan solo con consentimiento de cookies) ---
# Meta Pixel: ID numérico de ~16 dígitos (Meta Events Manager)
VITE_META_PIXEL_ID=
# GA4: formato G-XXXXXXXXXX (Google Analytics → Admin → Data Streams)
VITE_GA4_ID=

# --- Datos legales (Ley 1581 / Ley 1480 Colombia) ---
VITE_LEGAL_NAME=
VITE_NIT=
VITE_INVIMA=

# --- Contacto ---
VITE_SUPPORT_EMAIL=
# Solo dígitos, sin +57 (ej: 3001234567)
VITE_WHATSAPP_NUMBER=
# Usuario sin @ (ej: curve.colombia)
VITE_INSTAGRAM_USER=

# --- Comercial ---
# Debe existir en Shopify Admin → Discounts (5% OFF recomendado)
VITE_QUIZ_DISCOUNT_CODE=QUIZ5OFF

# ============================================================
# Sendura (pago contra entrega en ciudades con cobertura)
# ------------------------------------------------------------
# ⚠️  SIN prefijo VITE_: estas variables son del SERVIDOR (api/orders.js)
#     y nunca se exponen al navegador. Configúralas en Vercel para
#     Production Y Preview.
# ============================================================
# Token de la tienda: panel Sendura → Tiendas (Shops)
SENDURA_API_TOKEN=
# SKU del producto tal como existe en Inventarios de Sendura
SENDURA_SKU=
# (Opcional) SKU del plan 2 meses si es distinto; default: SENDURA_SKU
SENDURA_SKU_PLAN=
# (Opcional) URL base de la API; default: https://sendura.edgasanc.com
SENDURA_API_URL=

# ============================================================
# Wompi (pago online dentro del checkout propio)
# ------------------------------------------------------------
# ⚠️  SIN prefijo VITE_ — variables del servidor. La llave PRIVADA de
#     Wompi NO se usa ni se debe poner aquí.
# ============================================================
# Llave pública de producción (Wompi → Desarrolladores, pub_prod_...)
WOMPI_PUBLIC_KEY=
# "Secreto de integridad" (Wompi → Desarrolladores). Obligatorio para
# firmar los montos de pago.
WOMPI_INTEGRITY_SECRET=

# ============================================================
# Suscripción mensual (Sendura cobra recurrente vía Wompi)
# ------------------------------------------------------------
# Precio mensual del plan CURVE-MENSUAL en COP (default: 99000).
# Este valor es el que se muestra Y se cobra — una sola fuente de verdad.
SENDURA_SUB_PRICE=99000
# (Opcional) SKU específico del plan si difiere del producto normal
SENDURA_SUB_SKU=
